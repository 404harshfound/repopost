GROQ_API_KEY=your_groq_api_key

# GitHub OAuth — https://github.com/settings/developers → New OAuth App
# Set callback URL to: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth — https://developer.linkedin.com → Create App
# Set redirect URL to: http://localhost:8000/auth/linkedin/callback
# Products: "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Backend URL (used for OAuth redirect URIs)
BACKEND_URL=http://localhost:8000

# Frontend URL (used for CORS and postMessage target origin)
# For production, set to your Vercel deployment URL (e.g. https://repopost.vercel.app)
# Comma-separated for multiple origins (e.g. prod + preview)
FRONTEND_URL=http://localhost:5173

# GitHub Personal Access Token (optional, raises API rate limit from 60 to 5000 req/hr)
# Create at: https://github.com/settings/tokens → Fine-grained token → Public Repositories (read-only)
GITHUB_TOKEN=

# Secret for signing OAuth state cookies (auto-generated if not set)
STATE_SECRET=
